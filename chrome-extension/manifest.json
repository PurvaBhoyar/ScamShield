{
  "manifest_version": 3,
  "name": "ScamShield",
  "version": "1.0",
  "description": "Detect job scams before applying - scan URLs and job postings",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*.railway.app/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}